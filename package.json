    "crowdin:upload-all": "crowdin upload sources && crowdin upload translations",
    "crowdin:download": "crowdin download",
    "crowdin:progress": "node scripts/fetch-crowdin-progress.js",
    "test:sitemap": "node scripts/test-sitemap-hreflang.js",
    "test:constitution": "node scripts/test-constitution-toc.js",
    "test:events": "node scripts/test-events-model.js",
    "test:css": "node scripts/check-css.js",
    "test:docs-style": "node scripts/check-docs-style.js",
    "test:component-docs": "node scripts/check-component-docs.js",
    "test:js-assets": "node scripts/check-js-assets.js",
    "test:quiz-logic": "node --test scripts/test-quiz-progress.mjs",
    "test:quiz-data": "node scripts/check-quiz.js",
    "test:get-started": "node --test scripts/test-get-started.mjs",
    "test:stake-pools": "node --test scripts/test-stake-pools.mjs",
    "test:pool-loading": "node --test scripts/test-pool-loading.mjs",
    "test:pool-logos": "node --test scripts/test-pool-logos.js",
    "test:news-feed": "node --test scripts/test-news-feed.js",
    "test:wallet-tx": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-wallet-tx.mjs",
    "test:medusa-groups": "node scripts/test-medusa-groups.js",
    "test:medusa-history": "node scripts/test-medusa-history.js",
    "test:medusa-playback": "node scripts/test-medusa-playback.js",
    "test:medusa-graph": "node scripts/test-medusa-graph.js",
    "test:medusa-layout": "node scripts/test-medusa-layout.js",
    "test:i18n-dynamic": "node scripts/check-dynamic-translations.js",
    "test:drep-id-status": "node --test scripts/test-drep-id-status.mjs",
    "test:treasury-math": "node --test scripts/test-treasury-math.mjs",
    "test:timed-cache": "node --test scripts/test-timed-cache.mjs",
    "test:treasury-donations": "node --test scripts/test-treasury-donations-script.mjs",
    "test:hash-target": "node --test scripts/test-hash-target.mjs",
    "test:hash-anchor": "node --test scripts/test-hash-anchor-watch.mjs",
    "test": "yarn test:sitemap && yarn test:constitution && yarn test:events && yarn test:css && yarn test:docs-style && yarn test:component-docs && yarn test:quiz-logic && yarn test:quiz-data && yarn test:get-started && yarn test:stake-pools && yarn test:pool-loading && yarn test:pool-logos && yarn test:wallet-tx && yarn test:i18n-dynamic && yarn test:drep-id-status && yarn test:treasury-math && yarn test:timed-cache && yarn test:treasury-donations && yarn test:hash-target && yarn test:hash-anchor && yarn test:news-feed && yarn test:medusa-groups && yarn test:medusa-history && yarn test:medusa-playback && yarn test:medusa-graph && yarn test:medusa-layout",
    "lint": "eslint src scripts docusaurus.config.js",
    "lint:fix": "eslint --fix src scripts docusaurus.config.js"
  },
