{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build-authors": "node scripts/generate-authors-json.js",
    "build-news": "node scripts/generate-recent-news.js",
    "build-llms": "node scripts/generate-llms-txt.js",
    "build-apps-meta": "node scripts/generate-apps-metadata.js",
    "build-quiz": "node scripts/generate-quiz-modules.js",
    "check-app-screenshots": "node scripts/check-app-screenshots.js",
    "fetch-drep-avatars": "node scripts/fetch-drep-avatars.js",
    "fetch-pool-logos": "node scripts/fetch-pool-logos.js",
    "update-treasury-donations": "node scripts/update-treasury-donations.mjs",
    "docusaurus": "docusaurus",
    "start": "yarn check-app-screenshots && yarn build-authors && yarn build-news && yarn build-apps-meta && yarn build-quiz && yarn build-llms && docusaurus start",
    "build": "yarn check-app-screenshots && yarn build-authors && yarn build-news && yarn build-apps-meta && yarn build-quiz && yarn build-llms && docusaurus build",
    "postbuild": "node scripts/check-js-assets.js build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
